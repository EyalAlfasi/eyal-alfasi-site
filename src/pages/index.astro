---
import Container from '@components/Container.astro';
import PageLayout from '@layouts/PageLayout.astro';
import { HOME, SITE, SOCIALS } from '@consts';

const experience = [
  {
    company: 'DoorLoop',
    role: 'Senior Full Stack Engineer',
    period: 'Aug 2025 - Present',
    summary:
      'Leading complex product initiatives across frontend and backend, with a focus on maintainable architecture, shared foundations, and thoughtful delivery.',
  },
  {
    company: 'Unity',
    role: 'Full Stack Engineer',
    period: 'Jul 2022 - Dec 2024',
    summary:
      'Built and evolved production software in a large engineering organization, working across product systems and reusable frontend infrastructure.',
  },
  {
    company: 'Moveo Software',
    role: 'Full Stack Engineer',
    period: 'Jun 2021 - Jul 2022',
    summary:
      'Delivered end-to-end product work for fast-moving teams across several products, domains, and technology stacks.',
  },
];

const stack = [
  'TypeScript',
  'JavaScript',
  'React',
  'Angular',
  'Node.js',
  'NestJS',
  'PostgreSQL',
  'MongoDB',
  'Redis',
  'AWS',
  'Docker',
  'Event-driven systems',
];

const projectStack = [
  'TypeScript',
  'React',
  'Convex',
  'OpenAI',
  'Remotion',
  'AWS',
];
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <section class="hero-reference animate" aria-labelledby="intro-title">
      <p class="hero-kicker">Hi, my name is</p>
      <h1 id="intro-title">Eyal Alfasi.</h1>
      <h2>I build dependable software from end to end.</h2>
      <p>
        I’m a senior full-stack engineer focused on building production products
        that are clear, reliable, and maintainable. Currently, I’m working at
        <strong>DoorLoop</strong>, where I lead projects across frontend and
        backend.
      </p>
      <a class="outline-button" href="#work">See what I’ve built</a>
    </section>

    <section id="about" class="numbered-section animate" aria-labelledby="about-title">
      <div class="numbered-heading">
        <span>01.</span>
        <h2 id="about-title">About me</h2>
        <span class="heading-line"></span>
      </div>
      <div class="about-reference">
        <div class="about-copy">
          <p>
            I enjoy turning ambiguous product ideas into software that holds up
            in production. I’m comfortable moving between product decisions,
            interface details, backend systems, and the engineering work that
            connects them.
          </p>
          <p>
            I care about practical architecture, reusable foundations, and
            taking ownership from the first technical decision through rollout
            and iteration.
          </p>
          <p>
            Away from work, I run, lift, and play tennis. I was also Israel’s
            <a
              href="https://www.worldcubeassociation.org/persons/2010ALFA03"
              target="_blank"
              rel="noreferrer"
              aria-label="Eyal Alfasi's World Cube Association profile"
            >
              Rubik’s Cube champion from 2014 to 2019
            </a>, with a personal best of 3.68 seconds.
          </p>
        </div>
        <div class="about-side">
          <figure class="portrait-frame">
            <img
              src="/eyal-alfasi.webp"
              width="460"
              height="460"
              loading="lazy"
              decoding="async"
              alt="Eyal Alfasi smiling outdoors"
            />
          </figure>
          <div class="stack-panel">
            <p class="stack-label">Technologies I work with</p>
            <ul class="stack-grid" aria-label="Core technologies">
              {stack.map((technology) => <li>{technology}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section
      id="experience"
      class="numbered-section animate"
      aria-labelledby="experience-title"
    >
      <div class="numbered-heading">
        <span>02.</span>
        <h2 id="experience-title">Where I’ve worked</h2>
        <span class="heading-line"></span>
      </div>
      <ol class="experience-reference">
        {
          experience.map((item) => (
            <li>
              <div class="experience-title-row">
                <h3>
                  {item.role} <span>@ {item.company}</span>
                </h3>
                <time>{item.period}</time>
              </div>
              <p>{item.summary}</p>
            </li>
          ))
        }
      </ol>
      <a class="text-link" href="/work">
        View complete history <span aria-hidden="true">↗</span>
      </a>
    </section>

    <section id="work" class="numbered-section animate" aria-labelledby="work-title">
      <div class="numbered-heading">
        <span>03.</span>
        <h2 id="work-title">Something I’ve built</h2>
        <span class="heading-line"></span>
      </div>
      <article class="featured-project">
        <p class="project-label">Featured independent product</p>
        <h3>
          <a
            href="https://facelessclip.eyalalfasi.com/"
            target="_blank"
            rel="noreferrer"
          >
            FacelessClip <span aria-hidden="true">↗</span>
          </a>
        </h3>
        <p class="project-description">
          An AI video automation SaaS product I designed and built end to end,
          owning the product, application, and production delivery from the
          initial idea through launch.
        </p>
        <ul class="project-stack" aria-label="FacelessClip technologies">
          {projectStack.map((technology) => <li>{technology}</li>)}
        </ul>
      </article>
    </section>

    <section
      id="contact"
      class="contact-reference animate"
      aria-labelledby="contact-title"
    >
      <p>04. What’s next?</p>
      <h2 id="contact-title">Get in touch</h2>
      <span>
        Whether you have a question, an interesting technical problem, or just
        want to say hello, my inbox is open.
      </span>
      <a class="outline-button" href={`mailto:${SITE.EMAIL}`}>Say hello</a>
      <ul aria-label="Social links">
        {
          SOCIALS.map((social) => (
            <li>
              <a href={social.HREF} target="_blank" rel="noreferrer">
                {social.NAME}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </Container>
</PageLayout>
